datasource db {
  provider  = "postgresql"
  // Pooled connection (via PgBouncer) — used for normal app queries, safe
  // for serverless functions that open many short-lived connections.
  url       = env("DATABASE_URL")
  // Direct (unpooled) connection — required for migrations.
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String        @id
  name         String
  nickname     String?
  avatarEmoji  String        @default("🎀")
  avatarImage  String?
  email        String?       @unique
  upiId        String?
  color        String        @default("#FF6FAE")
  createdAt    DateTime      @default(now())

  paidExpenses Transaction[] @relation("PayerRelation")
  splits       Split[]
  circles      CircleMember[]
}

model Circle {
  id          String         @id
  name        String
  emoji       String         @default("🍔")
  description String?
  createdAt   DateTime       @default(now())

  members     CircleMember[]
  expenses    Transaction[]
}

model CircleMember {
  circleId  String
  userId    String
  circle    Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([circleId, userId])
}

model Transaction {
  id                String   @id @default(cuid())
  title             String
  category          String
  amountPaise       Int      // CRITICAL: Always store integer paise!
  payerId           String
  payer             User     @relation("PayerRelation", fields: [payerId], references: [id])

  circleId          String?
  circle            Circle?  @relation(fields: [circleId], references: [id])

  isSettlement      Boolean  @default(false)
  settledPaidToId   String?
  note              String?
  date              DateTime @default(now())
  createdAt         DateTime @default(now())

  splits            Split[]
}

model Split {
  id            String      @id @default(cuid())
  transactionId String
  userId        String
  amountPaise   Int

  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MenuItem {
  id          String   @id
  name        String
  priceRupees Int
  category    String
  section     String
  createdAt   DateTime @default(now())
}
